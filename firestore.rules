rules_version = '2';
// Only the booth's staff account(s) can read or change prizes and counts.
// Add more staff emails to the list to give them access, e.g. ["a@kodewithklossy.com", "b@kodewithklossy.com"].
service cloud.firestore {
  match /databases/{database}/documents {
    match /wheel/{doc} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ["madainn@kodewithklossy.com"];
    }
  }
}
